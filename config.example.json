{
  "settings": {
    "theme": "light",
    "start_with_windows": false,
    "hide_on_start": true,
    "keep_awake": true,
    "poll_interval_sec": 0.6,
    "sound_alert": false,
    "global_enabled": true
  },
  "rules": [
    {
      "id": "rule_example_01",
      "name": "Exemplu: schimbare de stare într-un portal de tichete",
      "enabled": true,
      "trigger": {
        "target_type": "any_window",
        "window_title_pattern": "*Portal Tichete*",
        "url_pattern": "*",
        "process_name": "browser",
        "text_condition": "contains",
        "search_text": "Changed from 'Merge' to 'Wait for Merge'",
        "case_sensitive": false,
        "is_regex": false,
        "additional_criteria": [],
        "criteria_logic": "OR"
      },
      "visual_cue": {
        "box_enabled": true,
        "border_color": "#EB780A",
        "border_width": 2,
        "fill_color": "#FFA500",
        "fill_opacity": 0.15,
        "arrow_enabled": true,
        "arrow_direction": "left",
        "arrow_color": "#00ff40",
        "arrow_style": "triangle",
        "arrow_width": 14,
        "arrow_size": 22,
        "badge_enabled": true,
        "badge_text": "STARE SCHIMBATĂ",
        "badge_bg": "#EB780A",
        "badge_fg": "#FFFFFF",
        "pulse_animation": true,
        "duration_sec": 3,
        "box_scope": "exact_text"
      },
      "region": {
        "mode": "window_relative",
        "rel_x": 0.2,
        "rel_y": 0.3,
        "width": 763,
        "height": 35,
        "monitor_index": -1
      },
      "steps": []
    },
    {
      "id": "rule_example_02",
      "name": "Exemplu: clasificare tichet pe o pagină anume",
      "enabled": true,
      "trigger": {
        "target_type": "browser_or_window",
        "window_title_pattern": "*Gateway*",
        "url_pattern": "*https://portal.exemplu.local/app/#/main*",
        "process_name": "browser",
        "text_condition": "contains",
        "search_text": "Please change category",
        "case_sensitive": false,
        "is_regex": false
      },
      "visual_cue": {
        "box_enabled": true,
        "border_color": "#008080",
        "border_width": 2,
        "fill_color": "#FF3333",
        "fill_opacity": 0.2,
        "arrow_enabled": true,
        "arrow_direction": "left",
        "arrow_color": "#ff0000",
        "arrow_size": 36,
        "badge_enabled": true,
        "badge_text": "🚨 SCHIMBĂ CATEGORIA!",
        "badge_bg": "#D90429",
        "badge_fg": "#FFFFFF",
        "pulse_animation": true,
        "duration_sec": 0,
        "box_scope": "exact_text"
      },
      "region": {
        "mode": "window_relative",
        "rel_x": 0.2,
        "rel_y": 0.3,
        "width": 310,
        "height": 30,
        "monitor_index": -1
      }
    },
    {
      "id": "rule_example_03",
      "name": "Exemplu: aceeași regulă, două titluri de fereastră posibile",
      "enabled": false,
      "trigger": {
        "target_type": "browser_or_window",
        "window_title_pattern": "*Platformă Service*|*Portal Tichete*",
        "url_pattern": "*",
        "process_name": "browser",
        "text_condition": "contains",
        "search_text": "Changed from 'Merge' to 'Wait for Merge'",
        "additional_criteria": [],
        "criteria_logic": "OR",
        "case_sensitive": false,
        "is_regex": false
      },
      "visual_cue": {
        "box_enabled": true,
        "box_scope": "exact_text",
        "border_color": "#FF0000",
        "border_width": 3,
        "fill_color": "#FF3333",
        "fill_opacity": 0.2,
        "arrow_enabled": true,
        "arrow_direction": "right",
        "arrow_color": "#FF0000",
        "arrow_style": "slim",
        "arrow_width": 14,
        "arrow_size": 22,
        "badge_enabled": false,
        "badge_text": "⚠️ MODIFICĂ AICI!",
        "badge_bg": "#D90429",
        "badge_fg": "#FFFFFF",
        "pulse_animation": true,
        "duration_sec": 0
      },
      "region": {
        "mode": "window_relative",
        "rel_x": 0.2,
        "rel_y": 0.3,
        "width": 814,
        "height": 38,
        "monitor_index": -1
      },
      "steps": []
    }
  ]
}
