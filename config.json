{
  "settings": {
    "theme": "light",
    "start_with_windows": true,
    "hide_on_start": true,
    "keep_awake": true,
    "poll_interval_sec": 1.0,
    "sound_alert": false,
    "global_enabled": true
  },
  "rules": [
    {
      "id": "rule_sample_01",
      "name": "Exemplu: Câmpuri Critice Portal Web",
      "enabled": false,
      "trigger": {
        "target_type": "browser_or_window",
        "window_title_pattern": "*Siemens*",
        "url_pattern": "*",
        "process_name": "msedge.exe",
        "text_condition": "contains",
        "search_text": "Obligatoriu",
        "case_sensitive": false,
        "is_regex": false
      },
      "visual_cue": {
        "box_enabled": true,
        "border_color": "#FF1A1A",
        "border_width": 3,
        "fill_color": "#FF3333",
        "fill_opacity": 0.2,
        "arrow_enabled": true,
        "arrow_direction": "right",
        "arrow_color": "#FF0000",
        "arrow_size": 36,
        "badge_enabled": true,
        "badge_text": "⚠️ MODIFICĂ / VERIFICĂ ACUM!",
        "badge_bg": "#D90429",
        "badge_fg": "#FFFFFF",
        "pulse_animation": true
      },
      "region": {
        "mode": "window_relative",
        "rel_x": 0.2,
        "rel_y": 0.3,
        "width": 350,
        "height": 60,
        "monitor_index": -1
      }
    },
    {
      "id": "rule_sample_02",
      "name": "Exemplu: Atenționare Text Critic (Generic)",
      "enabled": false,
      "trigger": {
        "target_type": "any_window",
        "window_title_pattern": "*",
        "url_pattern": "",
        "process_name": "",
        "text_condition": "contains",
        "search_text": "CONFIDENTIAL",
        "case_sensitive": false,
        "is_regex": false
      },
      "visual_cue": {
        "box_enabled": true,
        "border_color": "#EB780A",
        "border_width": 4,
        "fill_color": "#FFA500",
        "fill_opacity": 0.15,
        "arrow_enabled": true,
        "arrow_direction": "down",
        "arrow_color": "#EB780A",
        "arrow_size": 32,
        "badge_enabled": true,
        "badge_text": "🔒 SECTIUNE CRITICA",
        "badge_bg": "#EB780A",
        "badge_fg": "#FFFFFF",
        "pulse_animation": true
      },
      "region": {
        "mode": "entire_window",
        "rel_x": 0.05,
        "rel_y": 0.05,
        "width": 400,
        "height": 70,
        "monitor_index": -1
      }
    },
    {
      "id": "rule_6b16e036",
      "name": "ticket classification TIMA",
      "enabled": true,
      "trigger": {
        "target_type": "browser_or_window",
        "window_title_pattern": "*TIMA Web Gateway*",
        "url_pattern": "*https://tima.siemens.com/otwg20/#/main",
        "process_name": "chrome.exe",
        "text_condition": "contains",
        "search_text": "Please change category",
        "case_sensitive": false,
        "is_regex": false
      },
      "visual_cue": {
        "box_enabled": true,
        "border_color": "#FF0000",
        "border_width": 4,
        "fill_color": "#FF3333",
        "fill_opacity": 0.2,
        "arrow_enabled": true,
        "arrow_direction": "up",
        "arrow_color": "#FF0000",
        "arrow_size": 36,
        "badge_enabled": true,
        "badge_text": "🚨 SCHIMBĂ CATEGORIA TIMA!",
        "badge_bg": "#D90429",
        "badge_fg": "#FFFFFF",
        "pulse_animation": true
      },
      "region": {
        "mode": "window_relative",
        "rel_x": 0.1,
        "rel_y": 0.72,
        "width": 380,
        "height": 55,
        "monitor_index": -1
      }
    }
  ]
}